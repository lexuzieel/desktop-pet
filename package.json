{
  "name": "desktop-pet",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "description": "Desktop pet: a head in a jar",
  "author": "lexuzieel",
  "build": {
    "appId": "com.lexuzieel.desktoppet",
    "productName": "DesktopPet",
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "DesktopPet-${version}.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "fluid.js","scene.js","vendor/**",
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
